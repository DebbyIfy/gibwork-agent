# Copy this file to .env and fill in your own values.
# .env is git-ignored -- never commit real credentials.
#
# Only used when running with --reasoning --reasoning-provider api.
# Fixture mode with the mock provider (the default) needs none of this.

# Required for --reasoning-provider api. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=your_key_here

# Optional. Defaults to openrouter/free (OpenRouter's free multi-model router) if
# unset -- useful for testing real semantic reasoning without a paid key. Set to a
# specific OpenRouter model slug (e.g. anthropic/claude-haiku-4-5, openai/gpt-4o-mini)
# for a fixed, non-routed model instead.
OPENROUTER_MODEL=openrouter/free
