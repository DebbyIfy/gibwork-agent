# Copy this file to .env and fill in your own values.
# .env is git-ignored -- never commit real credentials.
#
# Only used when running with --reasoning --reasoning-provider api.
# Fixture mode with the mock provider (the default) needs none of this.

# Required for --reasoning-provider api. Get one at https://console.anthropic.com/
LLM_API_KEY=your_key_here

# Optional. Defaults to claude-haiku-4-5 (cheapest current model) if unset --
# this reasoning layer asks narrow, bounded questions over compact input, so a
# small/fast model is the appropriate default. Set to a larger model (e.g.
# claude-sonnet-5, claude-opus-4-8) for higher-quality reasoning at higher cost.
LLM_MODEL=claude-haiku-4-5
