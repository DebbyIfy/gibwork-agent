{
  "name": "gibwork-agent",
  "version": "1.0.0",
  "description": "",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gibwork-agent": "dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "review:fixture": "tsx src/index.ts review --fixture fixtures/task.json",
    "review:fixture:challenging": "tsx src/index.ts review --fixture fixtures/challenging-task.json",
    "review:fixture:reasoning": "tsx src/index.ts review --fixture fixtures/challenging-task.json --reasoning",
    "review:fixture:reasoning:api": "node dist/index.js review --fixture fixtures/challenging-task.json --reasoning --reasoning-provider api",
    "review:fixture:evidence": "tsx src/index.ts review --fixture fixtures/challenging-task.json --inspect-evidence",
    "test": "node --import tsx --test src/*.test.ts src/evaluation/*.test.ts src/evidence/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@gibwork/sdk": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
